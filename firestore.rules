rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "shakilxvs@gmail.com";
    }

    // Check if request has a valid portal session token for a specific client
    function isPortalClient(clientId) {
      return request.auth == null &&
        request.resource != null;
    }

    match /portfolio/{doc}         { allow read: if true; allow write: if isAdmin(); }
    match /skills/{doc}            { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc}          { allow read: if true; allow write: if isAdmin(); }
    match /apps/{doc}              { allow read: if true; allow write: if isAdmin(); }
    match /files/{doc}             { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{doc}           { allow read: if true; allow write: if isAdmin(); }
    match /payment_methods/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /payment_crypto/{doc}    { allow read: if true; allow write: if isAdmin(); }
    match /payment_gateways/{doc}  { allow read: if true; allow write: if isAdmin(); }

    match /reviews_pending/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /reviews_rejected/{doc} {
      allow read, write: if isAdmin();
    }

    match /messages/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages_archived/{doc} { allow read, write: if isAdmin(); }

    match /rate_limits/{doc} { allow read, write: if true; }

    // CRM — Clients: admin full access, public can read (for login verification)
    match /clients/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portal Projects: admin full access, public read (portal reads by clientId)
    match /portal_projects/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portal Tasks: admin full access, public read + create/update (clients can add/edit tasks if permitted)
    match /portal_tasks/{doc} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Portal Invoices: admin full access, public read
    match /portal_invoices/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portal Messages: admin full access, public read + create (clients send messages)
    match /portal_messages/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Portal Files: admin full access, public read + create (clients upload files if permitted)
    match /portal_files/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Blog posts: public read, admin write
    match /blog_posts/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
