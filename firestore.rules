rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Admin check ─────────────────────────────────────────
    // Accepts EITHER a Firebase Auth user with the `admin: true`
    // custom claim (the secure way), OR the legacy hardcoded
    // email as a temporary fallback during cutover.
    //
    // After verifying the custom claim works for ~24 hours,
    // delete the second line (the email check) — your email
    // will then be gone from this file entirely.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true
        || request.auth.token.email == "shakilxvs@gmail.com"
      );
    }

    // ─── Public-read collections (intentionally world-readable) ─
    match /portfolio/{doc}         { allow read: if true; allow write: if isAdmin(); }
    match /skills/{doc}            { allow read: if true; allow write: if isAdmin(); }
    match /projects/{doc}          { allow read: if true; allow write: if isAdmin(); }
    match /apps/{doc}              { allow read: if true; allow write: if isAdmin(); }
    match /files/{doc}             { allow read: if true; allow write: if isAdmin(); }
    match /reviews/{doc}           { allow read: if true; allow write: if isAdmin(); }
    match /payment_methods/{doc}   { allow read: if true; allow write: if isAdmin(); }
    match /payment_crypto/{doc}    { allow read: if true; allow write: if isAdmin(); }
    match /payment_gateways/{doc}  { allow read: if true; allow write: if isAdmin(); }
    match /blog_posts/{doc}        { allow read: if true; allow write: if isAdmin(); }

    // ─── Public form-submission collections ────────────────
    // Anyone can create (form submission); only admin can read/manage.
    match /reviews_pending/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /messages/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ─── Admin-only collections ────────────────────────────
    match /reviews_rejected/{doc}  { allow read, write: if isAdmin(); }
    match /messages_archived/{doc} { allow read, write: if isAdmin(); }

    // ─── Rate limits ───────────────────────────────────────
    // LOCKED DOWN — was previously world-writable, which made it
    // possible for any visitor to bypass the contact-form throttle.
    match /rate_limits/{doc} { allow read, write: if isAdmin(); }

    // ─── Sensitive portal collections ──────────────────────
    // ALL locked down to admin-only. Portal users access these
    // exclusively through /api/portal/* routes which use the
    // Admin SDK (bypasses these rules) and verify a signed JWT.
    match /clients/{doc}          { allow read, write: if isAdmin(); }
    match /portal_projects/{doc}  { allow read, write: if isAdmin(); }
    match /portal_tasks/{doc}     { allow read, write: if isAdmin(); }
    match /portal_invoices/{doc}  { allow read, write: if isAdmin(); }
    match /portal_messages/{doc}  { allow read, write: if isAdmin(); }
    match /portal_files/{doc}     { allow read, write: if isAdmin(); }

    // ─── Catch-all safety net ──────────────────────────────
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
